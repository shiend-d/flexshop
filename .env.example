# Kredensial PostgreSQL untuk Docker Compose
POSTGRES_USER=flexshop
# Gunakan password aman tanpa karakter khusus (@ : /) agar URL database tetap valid.
# Contoh: openssl rand -hex 24
POSTGRES_PASSWORD=flexshop
POSTGRES_DB=flexshop

# Ganti dengan string acak yang panjang, misalnya:
#   openssl rand -base64 32
JWT_SECRET=ubah-dengan-string-acak-panjang

# Untuk deploy pull-only (docker-compose.pull.yml / stack Portainer):
# APP_IMAGE=username/flexshop-app:latest
# DB_IMAGE=username/flexshop-db:latest

# Untuk menjalankan `npm run dev` di host (di luar Docker), buat .env.local.
# Port 5433 = port host untuk container db (menghindari bentrok dengan Postgres lokal di 5432).
# DATABASE_URL=postgres://flexshop:flexshop@localhost:5433/flexshop
